# Site Manager environment. Copy to .env.local (git-ignored) or set in the Vercel project.
# Fill a single key interactively without echoing it: npm run env:set -- TELEGRAM_BOT_TOKEN

# Anthropic (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium

# Telegram: create a bot with @BotFather (/newbot) and paste the token it gives you
TELEGRAM_BOT_TOKEN=
# Random secret Telegram echoes back in X-Telegram-Bot-Api-Secret-Token; generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Speech-to-text for voice notes: any OpenAI-compatible transcription endpoint.
# Default: Groq free tier (key from console.groq.com; ~20 req/min, 2,000/day). OpenAI: STT_BASE_URL=https://api.openai.com/v1, STT_MODEL=whisper-1
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3

# Supabase (project -> Settings -> API). The anon key is public; the service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase (project -> Settings -> Database -> Connection string, URI). Scripts only (db:apply).
SUPABASE_DB_URL=

# The deployment URL without a trailing slash; used for admin links and QR codes
PUBLIC_BASE_URL=http://localhost:3000
# Random secret for /api/tick (header x-tick-secret); generate: openssl rand -hex 32
TICK_SECRET=
DEMO_VENUE_SLUG=agala

# The Lovable landing (https://...); when set, / redirects there. Empty: / renders the built-in fallback landing.
NEXT_PUBLIC_LANDING_URL=

# Automatic deploys of wizard-created sites (Vercel Pro team). Token: vercel.com -> Settings -> Tokens, scope = the team
# (never a full-account token); server-only, never NEXT_PUBLIC_. Empty: the fake deployer is used (sites report READY at
# https://<slug>.example.test; nothing is deployed).
VERCEL_TOKEN=
# Team id (team_...) from Vercel -> Team Settings -> General; needed with a team-scoped token, empty for a personal account.
VERCEL_TEAM_ID=
# Salt for the hashed IPs in the wizard's rate limits; generate: openssl rand -hex 16. Set it in production
# (unset falls back to "dev-salt", which works but makes the hashes guessable).
RATE_SALT=
# New wizard drafts allowed per day across all visitors (default 50)
MAX_SITES_PER_DAY=50
# Bot username without @ (from @BotFather), for the https://t.me/<bot>?start=<code> link and QR on the wizard's done page
TELEGRAM_BOT_USERNAME=

# Meta channels (Messenger, Instagram, WhatsApp): one Meta app, see docs/CHANNELS.md. A channel is enabled when its token is set.
# App secret: Meta app → App settings → Basic. Required with any Meta token.
META_APP_SECRET=
# Any random string you also paste into the app's Webhooks "Verify token" field; generate: openssl rand -hex 16
META_VERIFY_TOKEN=
# Page access token with pages_messaging + instagram_manage_messages (Meta app → Messenger → Instagram settings → Generate token). Serves Messenger and Instagram.
META_PAGE_TOKEN=
# WhatsApp Cloud API token (Meta app → WhatsApp → API Setup; a system-user token for a permanent one) and the phone number id shown there
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (same API Setup page, next to the Phone number ID). Used only by `npm run meta:setup` to subscribe the account to this app.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# For invite deep links only: Page username (m.me/<handle>), Instagram username (ig.me/m/<user>), WhatsApp number with country code (wa.me/<digits>)
MESSENGER_PAGE_HANDLE=
INSTAGRAM_USERNAME=
WHATSAPP_NUMBER=
# Encrypts destination secrets (the WordPress plugin token) at rest; 32 bytes; generate: openssl rand -hex 32
DESTINATION_SECRET_KEY=

# Wizard "Import photos from Instagram" (Instagram API with Instagram Login). From developers.facebook.com: your Business
# app -> Instagram -> API setup with Instagram login -> Instagram app ID and Instagram app secret (not the Facebook app's).
# Server-only. Register ${PUBLIC_BASE_URL}/api/new/instagram/callback as the OAuth redirect URI. Empty: the button is hidden.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# The wizard's done page and the dashboard offer Messenger, Instagram and WhatsApp owner links (MESSENGER_PAGE_HANDLE,
# INSTAGRAM_USERNAME, WHATSAPP_NUMBER above; a pasted m.me/instagram.com link is reduced to the handle) only when this is
# true AND that channel's token is set (META_PAGE_TOKEN, WHATSAPP_TOKEN). Turn it on once the Meta webhooks point at this
# deployment (docs/CHANNELS.md). Telegram is always shown.
CHANNELS_ENABLED=false

# Posting to the venue's own Facebook Page and Instagram account (dashboard → "Facebook and Instagram"). Same Meta app.
# Facebook: the app id from App settings → Basic (public) together with META_APP_SECRET above. Add Facebook Login for Business
# and register ${PUBLIC_BASE_URL}/api/social/facebook/callback under Facebook Login → Settings → Valid OAuth Redirect URIs.
# Instagram: INSTAGRAM_APP_ID / INSTAGRAM_APP_SECRET above; register ${PUBLIC_BASE_URL}/api/social/instagram/callback under
# Instagram → API setup with Instagram login → Set up Instagram business login → OAuth redirect URIs (next to the import's).
# Empty: that network's Connect button is hidden. Tokens are stored encrypted with DESTINATION_SECRET_KEY.
META_APP_ID=
# Optional, Facebook Login for Business: the Configuration ID (Facebook Login for Business → Configurations, a "User access
# token" configuration with pages_manage_posts, pages_read_engagement, pages_show_list). When set, the login sends config_id
# instead of the scope list.
META_LOGIN_CONFIG_ID=

# Meta App Review (leaving development mode). Public pages: ${PUBLIC_BASE_URL}/privacy (Privacy Policy URL) and
# ${PUBLIC_BASE_URL}/data-deletion (User Data Deletion URL). Callbacks, for Facebook Login and for Instagram Login:
# Deauthorize ${PUBLIC_BASE_URL}/api/meta/deauthorize, Data Deletion Request ${PUBLIC_BASE_URL}/api/meta/data-deletion; their
# signed_request is verified with META_APP_SECRET or INSTAGRAM_APP_SECRET. The address shown on both pages; empty = they
# tell owners to write from the bot instead.
PRIVACY_CONTACT_EMAIL=

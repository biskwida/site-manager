# Site Manager environment. Copy to .env.local (git-ignored) or set in the Vercel project.
# Fill a single key interactively without echoing it: npm run env:set -- TELEGRAM_BOT_TOKEN

# Anthropic (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=medium

# Telegram: create a bot with @BotFather (/newbot) and paste the token it gives you
TELEGRAM_BOT_TOKEN=
# Random secret Telegram echoes back in X-Telegram-Bot-Api-Secret-Token; generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Speech-to-text for voice notes: any OpenAI-compatible transcription endpoint.
# Default: Groq free tier (key from console.groq.com; ~20 req/min, 2,000/day). OpenAI: STT_BASE_URL=https://api.openai.com/v1, STT_MODEL=whisper-1
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3

# Supabase (project -> Settings -> API). The anon key is public; the service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase (project -> Settings -> Database -> Connection string, URI). Scripts only (db:apply).
SUPABASE_DB_URL=

# The deployment URL without a trailing slash; used for admin links and QR codes
PUBLIC_BASE_URL=http://localhost:3000
# Random secret for /api/tick (header x-tick-secret); generate: openssl rand -hex 32
TICK_SECRET=
DEMO_VENUE_SLUG=agala

# The Lovable landing (https://...); when set, / redirects there. Empty: / renders the built-in fallback landing.
NEXT_PUBLIC_LANDING_URL=

# Automatic deploys of wizard-created sites (Vercel Pro team). Token: vercel.com -> Settings -> Tokens, scope = the team
# (never a full-account token); server-only, never NEXT_PUBLIC_. Empty: the fake deployer is used (sites report READY at
# https://<slug>.example.test; nothing is deployed).
VERCEL_TOKEN=
# Team id (team_...) from Vercel -> Team Settings -> General; needed with a team-scoped token, empty for a personal account.
VERCEL_TEAM_ID=
# Salt for the hashed IPs in the wizard's rate limits; generate: openssl rand -hex 16. Set it in production
# (unset falls back to "dev-salt", which works but makes the hashes guessable).
RATE_SALT=
# New wizard drafts allowed per day across all visitors (default 50)
MAX_SITES_PER_DAY=50
# Bot username without @ (from @BotFather), for the https://t.me/<bot>?start=<code> link and QR on the wizard's done page
TELEGRAM_BOT_USERNAME=
